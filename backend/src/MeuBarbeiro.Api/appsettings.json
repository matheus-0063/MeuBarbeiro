{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "meu-barbeiro.events",
    "RequestedQueue": "appointments.requested",
    "StatusUpdatedQueue": "appointments.status-updated"
  },
  "Jwt": {
    "Issuer": "MeuBarbeiro.Api",
    "Audience": "MeuBarbeiro.App",
    "ExpirationMinutes": 120
  }
}
